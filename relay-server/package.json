{
  "name": "relay-server",
  "version": "0.1.0",
  "private": true,
  "description": "TELEMETRA relay server — normalizes game telemetry and broadcasts via WebSocket",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build --workspace=@telemetra/shared && tsc",
    "start": "npm run build --workspace=@telemetra/shared && tsx src/index.ts",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@telemetra/shared": "*",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
