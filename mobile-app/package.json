{
  "name": "mobile-app",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File ./scripts/free-metro-port.ps1 && npx cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start",
    "start:clear": "powershell -ExecutionPolicy Bypass -File ./scripts/free-metro-port.ps1 && npx cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start -c",
    "start:tunnel": "npx cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start --tunnel",
    "start:tunnel:clear": "npx cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start -c --tunnel",
    "android": "npx cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native/virtualized-lists": "0.81.5",
    "@telemetra/shared": "*",
    "expo": "^54.0.0",
    "expo-screen-orientation": "~9.0.9",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "webidl-conversions": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.1.10",
    "cross-env": "^10.1.0",
    "typescript": "^5.7.3"
  }
}
